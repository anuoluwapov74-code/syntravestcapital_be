[Unit]
Description=SyntraVestCapitals Django Backend (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/syntravestcapital/backend/syntravestcapital
EnvironmentFile=/var/www/syntravestcapital/backend/syntravestcapital/.env
ExecStart=/var/www/syntravestcapital/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8002 \
    --timeout 120 \
    --access-logfile /var/log/syntravestcapital/gunicorn-access.log \
    --error-logfile /var/log/syntravestcapital/gunicorn-error.log \
    syntravestcapital.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
